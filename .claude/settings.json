{
	"permissions": {
		"allow": [
			"Bash(dotnet build:*)",
			"Bash(dotnet test:*)",
			"Bash(dotnet format:*)",
			"Bash(dotnet ef migrations add:*)",
			"Bash(dotnet run --project evals/App.Evals -- oracle)",
			"Bash(pnpm lint)",
			"Bash(pnpm typecheck)",
			"Bash(pnpm e2e)"
		],
		"deny": [
			"Bash(dotnet run --project evals/App.Evals -- run --allow-paid)",
			"Read(./.env)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "bash .claude/hooks/format.sh"
					}
				]
			}
		]
	}
}
